# Copy to a private .env file and replace these generic host values.
# Docker Compose substitutes these values; the Python trader does not read .env.
# Use absolute Linux host paths. Do not put API keys in this file.
STOCKS_UID=1000
STOCKS_GID=100
STOCKS_APP_DIR=/srv/stocks/deployment/app
STOCKS_DATA_DIR=/srv/stocks/data
STOCKS_CREDENTIALS_FILE=/srv/stocks/private/alpaca.json
